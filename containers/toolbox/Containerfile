# Project source is streamed into a private tmpfs at run time and is never
# baked into either image stage.
FROM docker.io/library/python@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170 AS base

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 1000 --shell /bin/bash box

# The resolver cannot bootstrap from a lock it generates. This complete small
# wheel-only tree is therefore pinned explicitly, matching the reference model.
#
# TODO(pip-tools-json-hashes): pip and pip-tools are deliberately held back.
# pip-tools 7.6.1+ requests https://pypi.org/<name>/json (404) instead of
# https://pypi.org/pypi/<name>/json, silently loses PyPI digests, and downloads
# every release file to hash it (about 5 GiB and 5 minutes for the dev lock).
# pip-tools 7.6.0 is the last correct release and cannot run on pip 26.2+.
# Do not upgrade either pin until TODO.md "Restore current pip and pip-tools in
# the resolver bootstrap" confirms an upstream fix.
FROM base AS lock

RUN python -m pip install --quiet --only-binary=:all: \
        pip==26.1.2 \
        setuptools==84.0.0 \
        pip-tools==7.6.0 \
        build==1.6.1 \
        click==8.5.0 \
        packaging==26.3 \
        pyproject-hooks==1.3.3 \
        wheel==0.48.0

COPY containers/toolbox/entrypoint.sh /usr/local/sbin/toolbox-entrypoint
RUN chmod 0755 /usr/local/sbin/toolbox-entrypoint

USER box
WORKDIR /work
ENTRYPOINT ["/usr/local/sbin/toolbox-entrypoint"]

# All project-aware analysis and tests run from this hash-verified environment.
# ShellCheck is the only required OS-level checker; project source is supplied
# at run time and is never copied into the image.
FROM base AS dev

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes \
        --no-install-recommends \
        shellcheck \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-dev.txt /tmp/requirements-dev.txt
RUN python -m pip install --quiet --require-hashes \
        --requirement /tmp/requirements-dev.txt \
    && python -m pip check \
    && rm -f /tmp/requirements-dev.txt

COPY containers/toolbox/entrypoint.sh /usr/local/sbin/toolbox-entrypoint
RUN chmod 0755 /usr/local/sbin/toolbox-entrypoint

USER box
WORKDIR /work
ENTRYPOINT ["/usr/local/sbin/toolbox-entrypoint"]
